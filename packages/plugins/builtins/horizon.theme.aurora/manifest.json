{
  "id": "horizon.theme.aurora",
  "name": "极光主题",
  "version": "0.1.0",
  "description": "石墨色层次与青色强调，提供浅色和深色配色。",
  "author": "Horizon",
  "apiVersion": 1,
  "engines": {
    "horizon": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "kind": "declarative"
  },
  "activation": [],
  "requires": {},
  "optional": {},
  "capabilities": [],
  "contributes": {
    "views": [],
    "commands": [],
    "themes": [
      {
        "id": "horizon.theme.aurora",
        "apiVersion": 1,
        "label": "极光",
        "light": {
          "background": "#e7f1f1",
          "surface": "#f8fdfd",
          "text": "#244344",
          "muted": "#5c7a7c",
          "border": "#cfe1e1",
          "accent": "#397976",
          "onAccent": "#ffffff",
          "selection": "#cce8e5",
          "success": "#39674e",
          "warning": "#684c25",
          "error": "#9e4245"
        },
        "dark": {
          "background": "#171e20",
          "surface": "#202b2e",
          "text": "#e1f1f1",
          "muted": "#a3bec0",
          "border": "#3b5155",
          "accent": "#91d7d2",
          "onAccent": "#103536",
          "selection": "#294c4c",
          "success": "#9ad4b0",
          "warning": "#ecd4aa",
          "error": "#efafb3"
        },
        "radius": 22,
        "density": "comfortable",
        "tokenColors": {
          "light": [
            {
              "name": "Comments",
              "scope": [
                "comment",
                "punctuation.definition.comment",
                "meta.preprocessor"
              ],
              "settings": {
                "foreground": "#5c7a7c",
                "fontStyle": "italic"
              }
            },
            {
              "name": "Keywords",
              "scope": [
                "keyword",
                "storage",
                "variable.language"
              ],
              "settings": {
                "foreground": "#88508f"
              }
            },
            {
              "name": "Operators",
              "scope": "keyword.operator",
              "settings": {
                "foreground": "#4f6c78"
              }
            },
            {
              "name": "Strings",
              "scope": [
                "string",
                "constant.other.symbol",
                "markup.inline.raw",
                "markup.raw"
              ],
              "settings": {
                "foreground": "#386e45"
              }
            },
            {
              "name": "Numbers and constants",
              "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
              ],
              "settings": {
                "foreground": "#a4522a"
              }
            },
            {
              "name": "Functions",
              "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
              ],
              "settings": {
                "foreground": "#78601f"
              }
            },
            {
              "name": "Types",
              "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "support.other.namespace"
              ],
              "settings": {
                "foreground": "#267a78"
              }
            },
            {
              "name": "Variables",
              "scope": [
                "variable",
                "entity.name.variable"
              ],
              "settings": {
                "foreground": "#2f627d"
              }
            },
            {
              "name": "Parameters",
              "scope": "variable.parameter",
              "settings": {
                "foreground": "#93603c"
              }
            },
            {
              "name": "Properties",
              "scope": [
                "variable.other.property",
                "variable.object.property",
                "variable.other.object.property",
                "support.variable.property",
                "support.type.property-name",
                "meta.object-literal.key"
              ],
              "settings": {
                "foreground": "#246f82"
              }
            },
            {
              "name": "Tags",
              "scope": [
                "entity.name.tag",
                "support.class.component"
              ],
              "settings": {
                "foreground": "#2d7772"
              }
            },
            {
              "name": "Attributes",
              "scope": "entity.other.attribute-name",
              "settings": {
                "foreground": "#885a83"
              }
            },
            {
              "name": "CSS selectors",
              "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.name.tag.wildcard.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
              ],
              "settings": {
                "foreground": "#66599a"
              }
            },
            {
              "name": "Headings",
              "scope": [
                "markup.heading",
                "entity.name.section"
              ],
              "settings": {
                "foreground": "#88508f",
                "fontStyle": "bold"
              }
            },
            {
              "name": "Bold",
              "scope": "markup.bold",
              "settings": {
                "fontStyle": "bold"
              }
            },
            {
              "name": "Italic",
              "scope": "markup.italic",
              "settings": {
                "fontStyle": "italic"
              }
            },
            {
              "name": "Links",
              "scope": [
                "markup.underline.link",
                "string.other.link",
                "markup.link"
              ],
              "settings": {
                "foreground": "#276b9b",
                "fontStyle": "underline"
              }
            },
            {
              "name": "Invalid syntax",
              "scope": "invalid",
              "settings": {
                "foreground": "#a7445b"
              }
            }
          ],
