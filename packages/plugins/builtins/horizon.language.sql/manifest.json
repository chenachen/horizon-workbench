{
  "id": "horizon.language.sql",
  "name": "SQL 语言支持",
  "version": "0.1.0",
  "description": "为 SQL 文件提供语法高亮。",
  "author": "Horizon",
  "apiVersion": 1,
  "engines": {
    "horizon": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "kind": "declarative"
  },
  "activation": [
    "onLanguage:sql"
  ],
  "requires": {},
  "optional": {},
  "capabilities": [],
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": [
          "SQL"
        ],
        "extensions": [
          ".sql"
        ]
      }
    ],
    "grammars": [
      {
        "language": "sql",
        "scopeName": "source.sql",
        "path": "syntaxes/sql.tmLanguage.json"
      }
    ]
  }
}
