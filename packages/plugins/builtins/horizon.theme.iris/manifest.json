{
  "id": "horizon.theme.iris",
  "name": "鸢尾主题",
  "version": "0.1.0",
  "description": "紫色层次与鲜明选中配色，提供浅色和深色配色。",
  "author": "Horizon",
  "apiVersion": 1,
  "engines": {
    "horizon": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "kind": "declarative"
  },
  "activation": [],
  "requires": {},
  "optional": {},
  "capabilities": [],
  "contributes": {
    "views": [],
    "commands": [],
    "themes": [
      {
        "id": "horizon.theme.iris",
        "apiVersion": 1,
        "label": "鸢尾",
        "light": {
          "background": "#f0eafa",
          "surface": "#fefbff",
          "text": "#38254b",
          "muted": "#7b628e",
          "border": "#e4d5ef",
          "accent": "#7950a3",
          "onAccent": "#ffffff",
          "selection": "#e5d1fb",
          "success": "#39674e",
          "warning": "#684c25",
          "error": "#9e4245"
        },
        "dark": {
          "background": "#231b2e",
          "surface": "#30233d",
          "text": "#efe1fc",
          "muted": "#c1a9d5",
          "border": "#523b65",
          "accent": "#dbb2ff",
          "onAccent": "#43205d",
          "selection": "#624180",
          "success": "#9ad4b0",
          "warning": "#ecd4aa",
          "error": "#efafb3"
        },
        "radius": 28,
        "density": "spacious",
        "tokenColors": {
          "light": [
            {
              "name": "Comments",
              "scope": [
                "comment",
                "punctuation.definition.comment",
                "meta.preprocessor"
              ],
              "settings": {
                "foreground": "#7b628e",
                "fontStyle": "italic"
              }
            },
            {
              "name": "Keywords",
              "scope": [
                "keyword",
                "storage",
                "variable.language"
              ],
              "settings": {
                "foreground": "#8b419b"
              }
            },
            {
              "name": "Operators",
              "scope": "keyword.operator",
              "settings": {
                "foreground": "#725f87"
              }
            },
            {
              "name": "Strings",
              "scope": [
                "string",
                "constant.other.symbol",
                "markup.inline.raw",
                "markup.raw"
              ],
              "settings": {
                "foreground": "#397344"
              }
            },
            {
              "name": "Numbers and constants",
              "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
              ],
              "settings": {
                "foreground": "#aa522d"
              }
            },
            {
              "name": "Functions",
              "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
              ],
              "settings": {
                "foreground": "#88601e"
              }
            },
            {
              "name": "Types",
              "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "support.other.namespace"
              ],
              "settings": {
                "foreground": "#267783"
              }
            },
            {
              "name": "Variables",
              "scope": [
                "variable",
                "entity.name.variable"
              ],
              "settings": {
                "foreground": "#47659b"
              }
            },
            {
              "name": "Parameters",
              "scope": "variable.parameter",
              "settings": {
                "foreground": "#995e45"
              }
            },
            {
              "name": "Properties",
              "scope": [
                "variable.other.property",
                "variable.object.property",
                "variable.other.object.property",
                "support.variable.property",
                "support.type.property-name",
                "meta.object-literal.key"
              ],
              "settings": {
                "foreground": "#356e96"
              }
            },
            {
              "name": "Tags",
              "scope": [
                "entity.name.tag",
                "support.class.component"
              ],
              "settings": {
                "foreground": "#7656a5"
              }
            },
            {
              "name": "Attributes",
              "scope": "entity.other.attribute-name",
              "settings": {
                "foreground": "#9a5686"
              }
            },
            {
              "name": "CSS selectors",
              "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.name.tag.wildcard.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
              ],
              "settings": {
                "foreground": "#6d60a4"
              }
            },
            {
              "name": "Headings",
              "scope": [
                "markup.heading",
                "entity.name.section"
              ],
              "settings": {
                "foreground": "#8b419b",
                "fontStyle": "bold"
              }
            },
            {
              "name": "Bold",
              "scope": "markup.bold",
              "settings": {
                "fontStyle": "bold"
              }
            },
            {
              "name": "Italic",
              "scope": "markup.italic",
              "settings": {
                "fontStyle": "italic"
              }
            },
            {
              "name": "Links",
              "scope": [
                "markup.underline.link",
                "string.other.link",
                "markup.link"
              ],
              "settings": {
                "foreground": "#4269a9",
                "fontStyle": "underline"
              }
            },
            {
              "name": "Invalid syntax",
              "scope": "invalid",
              "settings": {
                "foreground": "#aa3f69"
              }
            }
          ],
          "dark": [
            {
              "name": "Comments",
