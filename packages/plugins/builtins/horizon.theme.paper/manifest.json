          "background": "#f4f1eb",
          "surface": "#fffefa",
          "text": "#34352d",
          "muted": "#737569",
          "border": "#e3e3d8",
          "accent": "#617251",
          "onAccent": "#ffffff",
          "selection": "#e4ebd9",
          "success": "#39674e",
          "warning": "#684c25",
          "error": "#9e4245"
        },
