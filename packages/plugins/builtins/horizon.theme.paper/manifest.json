                "markup.raw"
              ],
              "settings": {
                "foreground": "#4c6e35"
              }
            },
            {
              "name": "Numbers and constants",
              "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
