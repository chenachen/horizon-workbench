{
  "id": "horizon.theme.graphite",
  "name": "石墨主题",
  "version": "0.1.0",
  "description": "中性灰表面与青灰色强调，提供浅色和深色配色。",
  "author": "Horizon",
  "apiVersion": 1,
  "engines": {
    "horizon": ">=0.1.0 <0.2.0"
  },
  "runtime": {
    "kind": "declarative"
  },
  "activation": [],
  "requires": {},
  "optional": {},
  "capabilities": [],
  "contributes": {
    "views": [],
    "commands": [],
    "themes": [
      {
        "id": "horizon.theme.graphite",
        "apiVersion": 1,
        "label": "石墨",
        "light": {
          "background": "#eceeef",
          "surface": "#ffffff",
          "text": "#263234",
          "muted": "#626f72",
          "border": "#d9dfe0",
          "accent": "#335f66",
          "onAccent": "#ffffff",
          "selection": "#d8e9ec",
          "success": "#39674e",
          "warning": "#684c25",
          "error": "#9e4245"
        },
        "dark": {
          "background": "#161819",
          "surface": "#222526",
          "text": "#e2ebeb",
          "muted": "#a8b7ba",
          "border": "#3a4648",
          "accent": "#a6d1d8",
          "onAccent": "#163339",
          "selection": "#28474c",
          "success": "#9ad4b0",
          "warning": "#ecd4aa",
          "error": "#efafb3"
        },
        "radius": 6,
        "density": "compact",
        "tokenColors": {
          "light": [
            {
              "name": "Comments",
              "scope": [
                "comment",
                "punctuation.definition.comment",
                "meta.preprocessor"
              ],
              "settings": {
                "foreground": "#626f72",
                "fontStyle": "italic"
              }
            },
            {
              "name": "Keywords",
              "scope": [
                "keyword",
                "storage",
                "variable.language"
              ],
              "settings": {
                "foreground": "#795084"
              }
            },
            {
              "name": "Operators",
              "scope": "keyword.operator",
              "settings": {
                "foreground": "#58696f"
              }
            },
            {
              "name": "Strings",
              "scope": [
                "string",
                "constant.other.symbol",
                "markup.inline.raw",
                "markup.raw"
              ],
              "settings": {
                "foreground": "#476b3b"
              }
            },
            {
              "name": "Numbers and constants",
              "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
              ],
              "settings": {
                "foreground": "#98562f"
              }
            },
            {
              "name": "Functions",
              "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
              ],
              "settings": {
                "foreground": "#7e5e20"
              }
            },
            {
              "name": "Types",
              "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "support.other.namespace"
              ],
              "settings": {
                "foreground": "#286e73"
              }
            },
            {
              "name": "Variables",
              "scope": [
                "variable",
                "entity.name.variable"
              ],
              "settings": {
                "foreground": "#385e7a"
              }
            },
            {
              "name": "Parameters",
              "scope": "variable.parameter",
              "settings": {
                "foreground": "#845947"
              }
            },
            {
              "name": "Properties",
              "scope": [
                "variable.other.property",
                "variable.object.property",
                "variable.other.object.property",
                "support.variable.property",
                "support.type.property-name",
                "meta.object-literal.key"
              ],
              "settings": {
                "foreground": "#376e82"
              }
            },
            {
              "name": "Tags",
              "scope": [
                "entity.name.tag",
                "support.class.component"
              ],
              "settings": {
                "foreground": "#2b6c6d"
              }
            },
            {
              "name": "Attributes",
              "scope": "entity.other.attribute-name",
              "settings": {
                "foreground": "#7f586c"
              }
            },
            {
              "name": "CSS selectors",
              "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.name.tag.wildcard.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
              ],
              "settings": {
                "foreground": "#69628a"
              }
            },
            {
              "name": "Headings",
              "scope": [
                "markup.heading",
                "entity.name.section"
              ],
              "settings": {
                "foreground": "#795084",
                "fontStyle": "bold"
              }
            },
            {
              "name": "Bold",
              "scope": "markup.bold",
              "settings": {
                "fontStyle": "bold"
              }
            },
            {
              "name": "Italic",
              "scope": "markup.italic",
              "settings": {
                "fontStyle": "italic"
              }
            },
            {
              "name": "Links",
              "scope": [
                "markup.underline.link",
                "string.other.link",
                "markup.link"
              ],
              "settings": {
                "foreground": "#2e638c",
                "fontStyle": "underline"
              }
            },
            {
              "name": "Invalid syntax",
              "scope": "invalid",
              "settings": {
                "foreground": "#9e4245"
              }
            }
          ],
          "dark": [
            {
              "name": "Comments",
              "scope": [
                "comment",
                "punctuation.definition.comment",
                "meta.preprocessor"
              ],
              "settings": {
                "foreground": "#a1afb1",
                "fontStyle": "italic"
              }
            },
            {
              "name": "Keywords",
              "scope": [
                "keyword",
                "storage",
                "variable.language"
              ],
              "settings": {
                "foreground": "#c5abdf"
              }
            },
            {
              "name": "Operators",
              "scope": "keyword.operator",
              "settings": {
                "foreground": "#b6c4c7"
              }
            },
            {
              "name": "Strings",
              "scope": [
                "string",
                "constant.other.symbol",
                "markup.inline.raw",
                "markup.raw"
              ],
              "settings": {
                "foreground": "#b5cfa0"
              }
            },
            {
              "name": "Numbers and constants",
              "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other",
                "support.constant"
              ],
              "settings": {
                "foreground": "#dfb28c"
              }
            },
            {
              "name": "Functions",
              "scope": [
                "entity.name.function",
                "support.function",
                "variable.function"
              ],
              "settings": {
                "foreground": "#dfd09a"
              }
            },
            {
              "name": "Types",
              "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type",
                "support.class",
                "support.other.namespace"
              ],
              "settings": {
                "foreground": "#91d2d0"
              }
            },
            {
              "name": "Variables",
              "scope": [
                "variable",
                "entity.name.variable"
              ],
              "settings": {
                "foreground": "#c0d4e6"
              }
            },
            {
              "name": "Parameters",
              "scope": "variable.parameter",
              "settings": {
                "foreground": "#e0c1aa"
              }
            },
            {
              "name": "Properties",
              "scope": [
                "variable.other.property",
                "variable.object.property",
                "variable.other.object.property",
                "support.variable.property",
                "support.type.property-name",
                "meta.object-literal.key"
              ],
              "settings": {
                "foreground": "#a2ccdf"
              }
            },
            {
              "name": "Tags",
              "scope": [
                "entity.name.tag",
                "support.class.component"
              ],
              "settings": {
                "foreground": "#9ed2cb"
              }
            },
            {
              "name": "Attributes",
              "scope": "entity.other.attribute-name",
              "settings": {
                "foreground": "#d4b6ce"
              }
            },
            {
              "name": "CSS selectors",
              "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css",
                "entity.name.tag.wildcard.css",
                "entity.other.attribute-name.pseudo-class.css",
                "entity.other.attribute-name.pseudo-element.css"
              ],
              "settings": {
                "foreground": "#c6bce2"
              }
            },
            {
              "name": "Headings",
              "scope": [
                "markup.heading",
                "entity.name.section"
              ],
              "settings": {
                "foreground": "#c5abdf",
                "fontStyle": "bold"
              }
            },
            {
              "name": "Bold",
              "scope": "markup.bold",
              "settings": {
                "fontStyle": "bold"
              }
            },
            {
              "name": "Italic",
              "scope": "markup.italic",
              "settings": {
                "fontStyle": "italic"
              }
            },
            {
              "name": "Links",
              "scope": [
                "markup.underline.link",
                "string.other.link",
                "markup.link"
              ],
              "settings": {
                "foreground": "#abd0ee",
                "fontStyle": "underline"
              }
            },
            {
              "name": "Invalid syntax",
              "scope": "invalid",
              "settings": {
                "foreground": "#ecabb3"
              }
            }
          ]
        }
      }
    ]
  }
}
