{
  "name": "horizon-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Horizon — a modular desktop code workbench",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/desktop"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 4173 --directory design",
    "capture": "node scripts/capture.mjs",
    "check": "node scripts/check.mjs",
    "check:plugins": "node scripts/check-plugins.mjs",
    "check:customization": "node scripts/check-customization.mjs",
    "desktop:dev": "npm run dev --workspace @horizon/desktop",
    "desktop:build": "npm run build --workspace @horizon/desktop",
    "desktop:check": "npm run typecheck --workspace @horizon/desktop",
    "desktop": "node scripts/desktop-run.mjs dev",
    "desktop:release": "node scripts/desktop-run.mjs build"
  },
  "devDependencies": {
    "lucide": "0.468.0",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
