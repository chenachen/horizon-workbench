  "updateSource": "let view;\nexport async function activate(context) {\n  const refresh = async () => {\n    const snapshot = await context.git.status();\n    const includeUntracked = await context.settings.get('includeUntracked');\n    const changes = snapshot.files.filter(change => includeUntracked || change.kind !== 'untracked');\n    view?.dispose();\n    view = context.views.register('local.resume-read-only-changes.list', {\n      kind: 'list', title: `Git 更改 0.1.1 · ${changes.length}`,\n      items: changes.map((change, index) => ({\n        id: String(change.file?.fileId ?? change.fileId ?? change.path ?? index),\n        label: String(change.path ?? change.file?.displayPath ?? '文件'),\n        description: `${change.index}${change.worktree}`,\n      })),\n    });\n    await context.storage.set('lastRefresh', new Date().toISOString());\n  };\n  context.subscriptions.add(context.commands.register('local.resume-read-only-changes.refresh', refresh));\n  context.subscriptions.add(context.commands.register('local.resume-read-only-changes.fail', () => { throw new Error(\"FAKE_HORIZON_TOKEN_resume_20261101|/HORIZON_FAKE_PRIVATE_PATH/owned-fixture|HORIZON_FAKE_SOURCE_BODY_20261101\"); }));\n  await refresh();\n}\nexport function deactivate() { view?.dispose(); }\n",
