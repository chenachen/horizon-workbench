{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horizon",
  "version": "0.1.0",
  "identifier": "dev.horizon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Horizon",
      "width": 1280,
      "height": 800,
      "minWidth": 640,
      "minHeight": 480,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "backgroundColor": "#edf2f8"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/horizon-git", "binaries/horizon-rg", "binaries/horizon-extension-host"],
    "resources": {"licenses/ripgrep/":"licenses/ripgrep/", "../../extension-host/licenses/":"licenses/quickjs/", "../../../THIRD_PARTY_NOTICES.md":"THIRD_PARTY_NOTICES.md", "../../../LICENSE":"LICENSE", "../../../licenses/third-party/":"licenses/third-party/"},
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {"minimumSystemVersion": "12.0", "files": {"Helpers/HorizonPicker.app":"../../picker-service/target/HorizonPicker.app"}}
  }
}
